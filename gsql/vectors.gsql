USE GLOBAL
CREATE GLOBAL SCHEMA_CHANGE JOB add_vectors {
  ALTER VERTEX DocChunk ADD VECTOR ATTRIBUTE emb(DIMENSION=128, METRIC="COSINE");
  ALTER VERTEX ClosedCase ADD VECTOR ATTRIBUTE emb(DIMENSION=128, METRIC="COSINE");
  ALTER VERTEX InvestigationCase ADD VECTOR ATTRIBUTE emb(DIMENSION=128, METRIC="COSINE");
}
RUN GLOBAL SCHEMA_CHANGE JOB add_vectors
DROP JOB add_vectors
