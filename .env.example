# TigerGraph (local Community Edition defaults; for Savanna use the workspace URL and a secret/token)
TG_HOST=http://localhost:14240
TG_GRAPH=FraudGraph
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph

# Optional LLM (any OpenAI-compatible provider). Without a key the agent uses templates.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash

# Route graph tool calls through the TigerGraph MCP server instead of direct REST
USE_TIGERGRAPH_MCP=0
